# Server environment variables — copy to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# Client origin for CORS (update if client runs on a different port)
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL) — will be used in a later phase
DATABASE_URL=postgresql://user:password@localhost:5432/myemployee_portal

# JWT — will be used in the auth phase
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
