# Server environment variables — copy to .env and fill in values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Client origin for CORS (update if client runs on a different port)
CLIENT_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Full connection string takes priority over individual fields.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/myemployee_portal

# Individual fields (used if DATABASE_URL is not set — optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myemployee_portal
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
